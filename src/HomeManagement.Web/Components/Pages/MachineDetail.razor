@page "/machines/{Id:guid}"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using HomeManagement.Abstractions
@using HomeManagement.Abstractions.Models
@using Microsoft.Extensions.Options
@inject HomeManagement.Web.Services.IBrokerApi BrokerApi
@inject IOptions<HomeManagement.Web.Services.GrafanaOptions> GrafanaOpts
@inject NavigationManager Navigation

@if (_loading)
{
    <p>Loading machine...</p>
}
else if (!string.IsNullOrEmpty(_errorMessage))
{
    <h1>Machine</h1>
    <p class="error">@_errorMessage</p>
    <p><a href="/machines">&larr; Back to Machines</a></p>
}
else if (_machine is not null)
{
    <h1>@_machine.Hostname</h1>
    <p><a href="/machines">&larr; Back to Machines</a></p>

    <table>
        <tbody>
            <tr><td><strong>ID</strong></td><td>@_machine.Id</td></tr>
            <tr><td><strong>Hostname</strong></td><td>@_machine.Hostname</td></tr>
            @if (!string.IsNullOrEmpty(_machine.Fqdn))
            {
                <tr><td><strong>FQDN</strong></td><td>@_machine.Fqdn</td></tr>
            }
            <tr><td><strong>OS</strong></td><td>@_machine.OsType</td></tr>
            <tr><td><strong>OS Version</strong></td><td>@_machine.OsVersion</td></tr>
            <tr><td><strong>State</strong></td><td>@_machine.State</td></tr>
            <tr><td><strong>Connection Mode</strong></td><td>@_machine.ConnectionMode</td></tr>
            <tr><td><strong>Protocol</strong></td><td>@_machine.Protocol</td></tr>
            <tr><td><strong>Created</strong></td><td>@_machine.CreatedUtc.ToString("g")</td></tr>
            <tr><td><strong>Last Contact</strong></td><td>@_machine.LastContactUtc.ToString("g")</td></tr>
            @if (!string.IsNullOrEmpty(_machine.AgentVersion))
            {
                <tr><td><strong>Agent Version</strong></td><td>@_machine.AgentVersion</td></tr>
            }
        </tbody>
    </table>

    <!-- ── Live Prometheus metrics ────────────────────────────────────────── -->
    <h2 style="margin-top:24px; display:flex; align-items:center; gap:10px;">
        Live Status
        @if (_state is not null)
        {
            var onlineColor = _state.Online ? "#388e3c" : "#c62828";
            var onlineLabel = _state.Online ? "Online" : "Offline";
            <span style="font-size:0.75rem; font-weight:bold; background:@onlineColor; color:white;
                         border-radius:4px; padding:2px 8px;">@onlineLabel</span>
        }
    </h2>

    @if (_stateLoading)
    {
        <p style="color:#888;">Loading live metrics…</p>
    }
    else if (_state is not null)
    {
        @if (_state.CpuUsagePercent.HasValue || _state.MemoryTotalBytes.HasValue)
        {
            <table>
                <tbody>
                    @if (_state.CpuUsagePercent.HasValue)
                    {
                        <tr>
                            <td><strong>CPU Usage</strong></td>
                            <td>@($"{_state.CpuUsagePercent:F1}")%</td>
                        </tr>
                    }
                    @if (_state.MemoryTotalBytes.HasValue)
                    {
                        <tr>
                            <td><strong>Memory</strong></td>
                            <td>@FormatBytes(_state.MemoryUsedBytes) used of @FormatBytes(_state.MemoryTotalBytes)</td>
                        </tr>
                    }
                    @if (_state.DiskTotalBytes.HasValue)
                    {
                        <tr>
                            <td><strong>Disk</strong></td>
                            <td>@FormatBytes(_state.DiskFreeBytes) free of @FormatBytes(_state.DiskTotalBytes)</td>
                        </tr>
                    }
                    @if (_state.Uptime.HasValue)
                    {
                        <tr>
                            <td><strong>Uptime</strong></td>
                            <td>@FormatUptime(_state.Uptime.Value)</td>
                        </tr>
                    }
                    <tr>
                        <td><strong>Sampled</strong></td>
                        <td style="color:#888;">@_state.FetchedUtc.ToString("g") UTC</td>
                    </tr>
                </tbody>
            </table>
        }
        else
        {
            <p style="color:#888;">Live metrics unavailable — Prometheus integration may be disabled or this host has no exporter.</p>
        }
    }

    <!-- ── Grafana dashboard panels (F-5) ─────────────────────────────────── -->
    @if (GrafanaOpts.Value.IsConfigured)
    {
        var grafana = GrafanaOpts.Value;
        var isWindows = _machine.OsType == OsType.Windows;
        var dashUid = isWindows ? grafana.WindowsExporterDashboardUid : grafana.NodeExporterDashboardUid;
        var exporterPort = isWindows ? "9182" : "9100";
        var instanceLabel = $"{_machine.Hostname}:{exporterPort}";

        @if (!string.IsNullOrWhiteSpace(dashUid))
        {
            var dashboardUrl = $"{grafana.BaseUrl}/d/{dashUid}?orgId=1&var-instance={Uri.EscapeDataString(instanceLabel)}&from=now-3h&to=now&kiosk=tv";
            var cpuPanelUrl = $"{grafana.BaseUrl}/d-solo/{dashUid}?orgId=1&var-instance={Uri.EscapeDataString(instanceLabel)}&panelId={grafana.CpuPanelId}&from=now-3h&to=now&theme=light";
            var memPanelUrl = $"{grafana.BaseUrl}/d-solo/{dashUid}?orgId=1&var-instance={Uri.EscapeDataString(instanceLabel)}&panelId={grafana.MemoryPanelId}&from=now-3h&to=now&theme=light";

            <h2 style="margin-top:24px;">Grafana Metrics
                <a href="@dashboardUrl" target="_blank" style="font-size:0.8rem; margin-left:10px;">Open full dashboard ↗</a>
            </h2>
            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <iframe src="@cpuPanelUrl"
                        width="450" height="200"
                        frameborder="0"
                        title="CPU Usage — @_machine.Hostname"
                        style="border:1px solid #ddd; border-radius:4px;">
                </iframe>
                <iframe src="@memPanelUrl"
                        width="450" height="200"
                        frameborder="0"
                        title="Memory Usage — @_machine.Hostname"
                        style="border:1px solid #ddd; border-radius:4px;">
                </iframe>
            </div>
        }
    }

    <!-- ── Patch history (F-6) ───────────────────────────────────────────── -->
    <h2 style="margin-top:24px;">Patching</h2>
    @if (_patchHistoryLoading)
    {
        <p style="color:#888;">Loading patch history…</p>
    }
    else if (_patchHistory is not null && _patchHistory.Count > 0)
    {
        <table>
            <thead>
                <tr>
                    <th>Patch ID</th>
                    <th>Title</th>
                    <th>State</th>
                    <th>Applied</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var entry in _patchHistory.Take(10))
                {
                    <tr>
                        <td>@entry.PatchId</td>
                        <td>@entry.Title</td>
                        <td style="color:@(entry.State == PatchInstallState.Installed ? "#388e3c" : "#c62828");">
                            @entry.State
                        </td>
                        <td>@entry.TimestampUtc.ToString("g")</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (_patchHistory.Count > 10)
        {
            <p style="color:#888; font-size:0.85rem;">Showing 10 of @_patchHistory.Count entries.</p>
        }
    }
    else if (!_patchHistoryLoading)
    {
        <p style="color:#888;">No patch history recorded yet.</p>
    }

    <!-- ── Process listing (F-7) ─────────────────────────────────────────── -->
    <h2 style="margin-top:24px;">
        Processes
        @if (!_processesLoading && _processes is not null)
        {
            <span style="font-size:0.8rem; font-weight:normal; color:#888;"> (@_processes.Count running)</span>
        }
    </h2>
    @if (_processesLoading)
    {
        <p style="color:#888;">Loading processes…</p>
    }
    else if (_processesError is not null)
    {
        <p style="color:#888;">@_processesError</p>
    }
    else if (_processes is not null && _processes.Count > 0)
    {
        <input type="text"
               @bind="_processFilter"
               @bind:event="oninput"
               placeholder="Filter processes…"
               style="margin-bottom:8px; padding:4px 8px; width:250px;" />

        var filtered = string.IsNullOrWhiteSpace(_processFilter)
            ? _processes
            : _processes.Where(p => p.ProcessName.Contains(_processFilter, StringComparison.OrdinalIgnoreCase)).ToList();

        <table>
            <thead>
                <tr>
                    <th>PID</th>
                    <th>Name</th>
                    <th>Memory</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var proc in filtered.Take(100))
                {
                    <tr>
                        <td>@proc.ProcessId</td>
                        <td>@proc.ProcessName</td>
                        <td>@FormatBytes(proc.WorkingSetBytes)</td>
                        <td>@proc.Status</td>
                    </tr>
                }
            </tbody>
        </table>
        @if (filtered.Count > 100)
        {
            <p style="color:#888; font-size:0.85rem;">Showing 100 of @filtered.Count matching processes.</p>
        }
    }
    else if (!_processesLoading)
    {
        <p style="color:#888;">Process listing unavailable — requires Agent transport protocol.</p>
    }

    @if (_machine.Tags.Count > 0)
    {
        <h2>Tags</h2>
        <table>
            <thead>
                <tr><th>Key</th><th>Value</th></tr>
            </thead>
            <tbody>
                @foreach (var tag in _machine.Tags)
                {
                    <tr><td>@tag.Key</td><td>@tag.Value</td></tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter]
    public Guid Id { get; set; }

    private bool _loading = true;
    private bool _stateLoading = true;
    private bool _patchHistoryLoading = true;
    private bool _processesLoading = true;
    private Machine? _machine;
    private MachineStateSnapshot? _state;
    private IReadOnlyList<PatchHistoryEntry>? _patchHistory;
    private IReadOnlyList<ProcessInfo>? _processes;
    private string? _errorMessage;
    private string? _processesError;
    private string _processFilter = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _machine = await BrokerApi.GetMachineAsync(Id);
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
            return;
        }
        catch (Exception ex)
        {
            _errorMessage = $"Unable to load machine: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }

        if (_machine is null) return;

        // Fire all secondary loads in parallel so machine info renders immediately
        var stateTask = LoadStateAsync();
        var patchTask = LoadPatchHistoryAsync();
        var processTask = LoadProcessesAsync();

        await Task.WhenAll(stateTask, patchTask, processTask);
    }

    private async Task LoadStateAsync()
    {
        try
        {
            _state = await BrokerApi.GetMachineStateAsync(Id);
        }
        catch
        {
            // State load failure is non-fatal — show machine info without live metrics
        }
        finally
        {
            _stateLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadPatchHistoryAsync()
    {
        try
        {
            _patchHistory = await BrokerApi.GetPatchHistoryAsync(Id);
        }
        catch
        {
            _patchHistory = [];
        }
        finally
        {
            _patchHistoryLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadProcessesAsync()
    {
        try
        {
            _processes = await BrokerApi.GetMachineProcessesAsync(Id);
        }
        catch (Exception ex)
        {
            _processesError = $"Process listing unavailable: {ex.Message}";
            _processes = [];
        }
        finally
        {
            _processesLoading = false;
            StateHasChanged();
        }
    }

    private static string FormatBytes(long? bytes)
    {
        if (bytes is null) return "—";
        double gb = bytes.Value / (1024.0 * 1024.0 * 1024.0);
        return gb >= 1 ? $"{gb:F1} GB" : $"{bytes.Value / (1024.0 * 1024.0):F0} MB";
    }

    private static string FormatUptime(TimeSpan ts) =>
        ts.TotalDays >= 1
            ? $"{(int)ts.TotalDays}d {ts.Hours}h {ts.Minutes}m"
            : $"{ts.Hours}h {ts.Minutes}m";
}
