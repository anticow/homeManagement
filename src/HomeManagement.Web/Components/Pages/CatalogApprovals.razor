@page "/action1/catalog"
@page "/fleet/schedules"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@using HomeManagement.Web.Services
@inject IBrokerApi BrokerApi
@inject NavigationManager Navigation

<h1>Patch Management</h1>

<div style="display:flex; align-items:center; gap:8px; margin-bottom:16px;">
    <label for="patch-management-section" style="font-weight:600; color:#333;">Section:</label>
    <select id="patch-management-section" value="@_activeSection" @onchange="OnSectionChanged" style="padding:6px 12px; border:1px solid #ddd; border-radius:4px; font-size:0.88rem;">
        <option value="approvals">Update Approvals</option>
        <option value="schedules">Patch Schedules</option>
    </select>
</div>

@if (_activeSection == "approvals")
{
    <h2 style="margin-top:0;">Update Catalog Approvals</h2>
    <p style="color:#555; margin-bottom:16px;">
        Org-level update catalog — the same queue visible in Action1's Update Approval screen.
        Approving here marks updates as <strong>Approved</strong> in Action1 so they are
        deployed by your scheduled automations during the next maintenance window.
    </p>

    @if (_error is not null)
    {
        <div style="background:#fff3e0; border:1px solid #f57c00; border-radius:4px; padding:12px; margin-bottom:16px;">
            <strong>⚠ Action1 Unavailable:</strong> @_error
        </div>
    }

    @if (_approveResult is not null)
    {
        var hasProblems = _approveResult.Failed > 0 || _approveResult.Skipped > 0;
        <div style="background:@(hasProblems ? "#fff3e0" : "#e8f5e9"); border:1px solid @(hasProblems ? "#f57c00" : "#388e3c"); border-radius:4px; padding:12px; margin-bottom:16px;">
            @if (!hasProblems)
            {
                <strong style="color:#388e3c;">✔ @_approveResult.Succeeded update(s) approved successfully.</strong>
            }
            else
            {
                <strong>⚠ @_approveResult.Succeeded approved@(_approveResult.Failed > 0 ? $", {_approveResult.Failed} failed" : "")@(_approveResult.Skipped > 0 ? $", {_approveResult.Skipped} require manual approval" : "").</strong>
                @if (_approveResult.FailedIds.Count > 0)
                {
                    <div style="margin-top:4px; font-size:0.85rem; color:#c62828;">Failed IDs: @string.Join(", ", _approveResult.FailedIds)</div>
                }
                @if (_approveResult.SkippedIds.Count > 0)
                {
                    <div style="margin-top:6px; font-size:0.85rem; color:#e65100;">
                        <strong>⚠ Software delivery packages not approvable via API — approve manually in Action1 console (Software Delivery):</strong>
                        <div style="margin-top:2px; font-family:monospace; font-size:0.78rem;">@string.Join(", ", _approveResult.SkippedIds)</div>
                    </div>
                }
            }
        </div>
    }

    @if (_jobProgress is not null && !_jobProgress.IsComplete)
    {
        var pct = _jobProgress.Total > 0 ? (int)(_jobProgress.Processed * 100.0 / _jobProgress.Total) : 0;
        <div style="margin-bottom:16px; background:#e3f2fd; border:1px solid #1976d2; border-radius:6px; padding:12px;">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:6px;">
                <span style="font-size:0.88rem; font-weight:600; color:#1565c0;">
                    Approving… @_jobProgress.Processed / @_jobProgress.Total
                </span>
                <span style="font-size:0.82rem; color:#555;">
                    ✔ @_jobProgress.Succeeded succeeded&nbsp;
                    @if (_jobProgress.Failed > 0) { <span style="color:#c62828;">✗ @_jobProgress.Failed failed&nbsp;</span> }
                    @if (_jobProgress.Skipped > 0) { <span style="color:#e65100;">⏭ @_jobProgress.Skipped manual</span> }
                </span>
            </div>
            <div style="background:#bbdefb; border-radius:4px; height:8px; overflow:hidden;">
                <div style="background:#1976d2; width:@(pct)%; height:100%; border-radius:4px; transition:width 0.4s ease;"></div>
            </div>
            <div style="margin-top:4px; font-size:0.78rem; color:#555;">@pct% — items with 429 rate limits will retry automatically after a 60s cool-down</div>
        </div>
    }

    <div style="display:flex; gap:12px; flex-wrap:wrap; align-items:center; margin-bottom:16px; padding:12px; background:#f5f5f5; border-radius:6px;">
        <div style="display:flex; align-items:center; gap:6px;">
            <strong style="font-size:0.9rem;">View:</strong>
            <button style="@StatusBtnStyle("New")" @onclick='() => SwitchStatus("New")'>New (@(_statusCounts.GetValueOrDefault("New")))</button>
            <button style="@StatusBtnStyle("Approved")" @onclick='() => SwitchStatus("Approved")'>Approved (@(_statusCounts.GetValueOrDefault("Approved")))</button>
            <button style="@StatusBtnStyle("Declined")" @onclick='() => SwitchStatus("Declined")'>Declined (@(_statusCounts.GetValueOrDefault("Declined")))</button>
        </div>
        <div style="display:flex; align-items:center; gap:6px;">
            <strong style="font-size:0.9rem;">Severity:</strong>
            @foreach (var sev in new[] { "All", "Critical", "Important", "Moderate", "Low" })
            {
                <button style="@SeverityFilterBtnStyle(sev)" @onclick="() => _severityFilter = sev">@sev</button>
            }
        </div>
        <div style="display:flex; gap:8px; margin-left:auto; align-items:center;">
            <button style="@BtnStyle("default")" @onclick="ReloadApprovalsAsync" disabled="@_loading">⟳ Refresh</button>
            <button style="@BtnStyle("default")" @onclick="TestConnection" disabled="@_testing">
                🔬 Test API
            </button>
            @if (_testResult is not null)
            {
                <span style="font-size:0.8rem; color:@(_testResult.Success ? "#388e3c" : "#c62828"); margin-left:8px;">
                    @(_testResult.Success
                        ? $"✔ OK ({_testResult.ItemCount} items, {_testResult.ElapsedMs}ms)"
                        : $"✗ {_testResult.Error}")
                </span>
            }
            @if (_currentStatus == "New" && TotalSelectedCount > 0)
            {
                <button style="@BtnStyle("danger-outline")" @onclick="DeclineSelected" disabled="@_submitting">
                    ✗ Decline (@TotalSelectedCount)
                </button>
                <button style="@BtnStyle("primary")" @onclick="ApproveSelected" disabled="@_submitting">
                    @(_submitting ? "Approving…" : $"✔ Approve Selected ({TotalSelectedCount})")
                </button>
            }
            @if (_currentStatus == "New" && VisibleUpdates.Count > 0 && TotalSelectedCount == 0)
            {
                <button style="@BtnStyle("primary")" @onclick="ApproveAll" disabled="@_submitting">
                    @(_submitting ? "Approving…" : $"✔ Approve All ({VisibleUpdates.Count})")
                </button>
            }
        </div>
    </div>

    @if (_loading)
    {
        <p style="color:#888;">Loading update catalog…</p>
    }
    else if (_updates is not null)
    {
        @if (VisibleUpdates.Count == 0)
        {
            <div style="background:#e8f5e9; border:1px solid #388e3c; border-radius:4px; padding:16px; text-align:center;">
                <strong style="color:#388e3c;">✓ No updates with status "@_currentStatus"@(_severityFilter != "All" ? $" / {_severityFilter} severity" : "").</strong>
            </div>
        }
        else
        {
            <div style="margin-bottom:8px; font-size:0.88rem; color:#555;">
                Showing @VisibleUpdates.Count update(s)
                @if (TotalSelectedCount > 0) { <span> — <strong>@TotalSelectedCount selected</strong></span> }
            </div>

            <table style="width:100%; border-collapse:collapse; font-size:0.85rem;">
                <thead>
                    <tr style="background:#fafafa; border-bottom:2px solid #e0e0e0; text-align:left;">
                        @if (_currentStatus == "New")
                        {
                            <th style="padding:8px 12px; width:36px;">
                                <input type="checkbox"
                                       checked="@AllVisibleSelected"
                                       @onchange="e => ToggleAll((bool)(e.Value ?? false))"
                                       title="Select all" />
                            </th>
                        }
                        <th style="padding:8px 12px;">Update</th>
                        <th style="padding:8px 12px;">Severity</th>
                        <th style="padding:8px 12px;">Version</th>
                        <th style="padding:8px 12px;">Type</th>
                        <th style="padding:8px 12px;">Published</th>
                        <th style="padding:8px 12px;">KB</th>
                        <th style="padding:8px 12px; text-align:center;">Reboot</th>
                        <th style="padding:8px 12px;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in VisibleUpdates)
                    {
                        var isSelected = _selected.Contains(u.Id);
                        <tr style="border-bottom:1px solid #f0f0f0; background:@(isSelected ? "#e8f0fe" : "white");">
                            @if (_currentStatus == "New")
                            {
                                <td style="padding:8px 12px; text-align:center;">
                                    <input type="checkbox"
                                           checked="@isSelected"
                                           @onchange="e => ToggleOne(u.Id, (bool)(e.Value ?? false))" />
                                </td>
                            }
                            <td style="padding:8px 12px; font-weight:@(IsCritical(u) ? "600" : "normal");">
                                @u.Name
                                @if (!string.IsNullOrEmpty(u.Description))
                                {
                                    <div style="color:#777; font-size:0.78rem; margin-top:2px; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:400px;" title="@u.Description">
                                        @u.Description
                                    </div>
                                }
                            </td>
                            <td style="padding:8px 12px;">
                                <span style="@SeverityBadgeStyle(u.Severity)">@(u.Severity ?? "—")</span>
                            </td>
                            <td style="padding:8px 12px; color:#555; white-space:nowrap;">@(u.Version ?? "—")</td>
                            <td style="padding:8px 12px; color:#555; white-space:nowrap; font-size:0.8rem;">@(u.UpdateType ?? u.Category ?? "—")</td>
                            <td style="padding:8px 12px; color:#555; white-space:nowrap; font-size:0.8rem;">
                                @(u.PublishedUtc.HasValue ? u.PublishedUtc.Value.ToString("MM/dd/yyyy") : "—")
                            </td>
                            <td style="padding:8px 12px;">
                                @if (!string.IsNullOrEmpty(u.KbArticleId))
                                {
                                    <a href="https://support.microsoft.com/kb/@u.KbArticleId"
                                       target="_blank"
                                       style="color:#1565c0; font-size:0.82rem;">@u.KbArticleId</a>
                                }
                                else { <span style="color:#aaa;">—</span> }
                            </td>
                            <td style="padding:8px 12px; text-align:center;">
                                @(u.RequiresReboot ? "🔄" : "—")
                            </td>
                            <td style="padding:8px 12px;">
                                <span style="@ApprovalBadgeStyle(u.ApprovalStatus)">@(u.ApprovalStatus ?? "—")</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
}
else
{
    <h2 style="margin-top:0;">Patch Schedules</h2>
    <p style="color:#555; margin-bottom:16px;">
        Manage severity-based automated patch deployment schedules in Action1.
        Schedules marked <strong>HM-Managed</strong> are created and owned by HomeManagement.
    </p>

    @if (_scheduleError is not null)
    {
        <div style="background:#ffebee; border:1px solid #c62828; border-radius:4px; padding:12px; margin-bottom:16px;">
            <strong>⚠ Error:</strong> @_scheduleError
        </div>
    }

    @if (!_schedulesLoading && _scheduleList is not null && !_scheduleList.SyncConfigured)
    {
        <div style="background:#e3f2fd; border:1px solid #1565c0; border-radius:4px; padding:12px; margin-bottom:16px;">
            <strong>ℹ Schedule sync not configured.</strong>
            To enable automated schedule management, add the following to your broker configuration:
            <pre style="margin:8px 0 0; font-size:0.82rem; background:#f5f5f5; padding:8px; border-radius:3px;">Action1:ScheduleSync:Enabled=true
Action1:ScheduleSync:Rules:0:Name=Critical patches
Action1:ScheduleSync:Rules:0:Severities:0=Critical
Action1:ScheduleSync:Rules:0:AutoApprove=true
Action1:ScheduleSync:Rules:0:DeferDays=7</pre>
            Existing Action1 schedules are shown below (read-only until sync is configured).
        </div>
    }

    @if (_scheduleSyncResult is not null)
    {
        <div style="background:#e8f5e9; border:1px solid #388e3c; border-radius:4px; padding:12px; margin-bottom:16px;">
            <strong>✔ Sync complete.</strong>
            Created: @_scheduleSyncResult.Created.Count, Updated: @_scheduleSyncResult.Updated.Count
            @if (_scheduleSyncResult.Created.Count > 0)
            {
                <ul style="margin:4px 0 0; padding-left:20px;">
                    @foreach (var name in _scheduleSyncResult.Created) { <li>@name</li> }
                </ul>
            }
        </div>
    }

    <div style="margin-bottom:16px; display:flex; gap:8px; align-items:center;">
        @if (_scheduleList?.SyncConfigured == true)
        {
            <button style="@ScheduleBtnStyle("primary")" @onclick="SyncNow" disabled="@_syncing">
                @(_syncing ? "Syncing…" : "↻ Sync Now")
            </button>
        }
        else
        {
            <button style="@ScheduleBtnStyle("primary")" disabled title="Configure Action1:ScheduleSync first">
                ↻ Sync Now
            </button>
        }
        <button style="@ScheduleBtnStyle("default")" @onclick="ReloadSchedulesAsync" disabled="@_schedulesLoading">
            @(_schedulesLoading ? "Loading…" : "⟳ Refresh")
        </button>
        @if (_scheduleList?.SyncConfigured == true)
        {
            <span style="color:#388e3c; font-size:0.85rem;">@_scheduleList.RuleCount rule(s) configured</span>
        }
    </div>

    @if (_schedulesLoading)
    {
        <p style="color:#888;">Loading schedules…</p>
    }
    else if (_scheduleList is not null)
    {
        @if (_scheduleList.Schedules.Count == 0)
        {
            <p style="color:#888;">No schedules found in Action1.
                @if (_scheduleList.SyncConfigured)
                {
                    <span>Click <em>Sync Now</em> to create HM-managed schedules.</span>
                }
            </p>
        }
        else
        {
            <table style="width:100%; border-collapse:collapse; font-size:0.9rem;">
                <thead>
                    <tr style="border-bottom:2px solid #ddd; text-align:left;">
                        <th style="padding:8px 12px;">Name</th>
                        <th style="padding:8px 12px;">Approval</th>
                        <th style="padding:8px 12px;">Defer Days</th>
                        <th style="padding:8px 12px;">Status</th>
                        <th style="padding:8px 12px;">Reboot</th>
                        <th style="padding:8px 12px;">Owner</th>
                        <th style="padding:8px 12px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _scheduleList.Schedules)
                    {
                        var rowBg = s.IsManagedByHm ? "#f3f8ff" : "white";
                        var isDisabled = (s.Settings ?? "").StartsWith("DISABLED", StringComparison.OrdinalIgnoreCase);
                        <tr style="border-bottom:1px solid #eee; background:@rowBg;">
                            <td style="padding:8px 12px; font-weight:@(s.IsManagedByHm ? "600" : "normal");">@s.Name</td>
                            <td style="padding:8px 12px;">
                                @if (s.UpdateApproval == "auto")
                                { <span style="color:#1565c0;">● Auto</span> }
                                else
                                { <span style="color:#f57c00;">● Manual</span> }
                            </td>
                            <td style="padding:8px 12px;">
                                @if (s.DeferDays > 0) { <span>@s.DeferDays days</span> }
                                else { <span style="color:#888;">—</span> }
                            </td>
                            <td style="padding:8px 12px;">
                                @if (isDisabled) { <span style="color:#888;">⏸ Disabled</span> }
                                else { <span style="color:#388e3c;">▶ Active</span> }
                            </td>
                            <td style="padding:8px 12px;">@(s.AllowReboot ? "✓" : "✗")</td>
                            <td style="padding:8px 12px;">
                                @if (s.IsManagedByHm)
                                { <span style="background:#1565c0; color:white; border-radius:3px; padding:2px 6px; font-size:0.75rem;">HM-Managed</span> }
                                else
                                { <span style="color:#888; font-size:0.85rem;">External</span> }
                            </td>
                            <td style="padding:8px 12px;">
                                @if (s.IsManagedByHm)
                                {
                                    @if (isDisabled)
                                    { <button style="@ScheduleBtnStyle("small-primary")" @onclick="() => EnableSchedule(s)">Enable</button> }
                                    else
                                    { <button style="@ScheduleBtnStyle("small-warn")" @onclick="() => DisableSchedule(s)">Disable</button> }
                                    <button style="@ScheduleBtnStyle("small-danger")" @onclick="() => ConfirmDelete(s)">Delete</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }

    @if (_deleteTarget is not null)
    {
        <div style="position:fixed; inset:0; background:rgba(0,0,0,0.4); display:flex; align-items:center; justify-content:center; z-index:100;">
            <div style="background:white; border-radius:8px; padding:24px; max-width:400px; width:90%;">
                <h3 style="margin-top:0;">Delete Schedule?</h3>
                <p>Are you sure you want to delete <strong>@_deleteTarget.Name</strong> from Action1? This cannot be undone.</p>
                <div style="display:flex; gap:8px; justify-content:flex-end;">
                    <button style="@ScheduleBtnStyle("default")" @onclick="CancelDelete">Cancel</button>
                    <button style="@ScheduleBtnStyle("danger")" @onclick="ExecuteDelete">Delete</button>
                </div>
            </div>
        </div>
    }
}

@code {
    private string _activeSection = "approvals";

    private IReadOnlyList<CatalogUpdateDto>? _updates;
    private string? _error;
    private bool _loading = true;
    private bool _submitting;
    private bool _testing;
    private string _currentStatus = "New";
    private string _severityFilter = "All";
    private readonly HashSet<string> _selected = new(StringComparer.OrdinalIgnoreCase);
    private ApprovalJobStatusDto? _approveResult;
    private ApprovalJobStatusDto? _jobProgress;
    private CatalogTestResultDto? _testResult;
    private bool _approvalsLoaded;

    private readonly Dictionary<string, int> _statusCounts = new()
    {
        ["New"] = 0, ["Approved"] = 0, ["Declined"] = 0
    };

    private ScheduleListDto? _scheduleList;
    private ScheduleSyncResultDto? _scheduleSyncResult;
    private string? _scheduleError;
    private bool _schedulesLoading = true;
    private bool _syncing;
    private ScheduleDto? _deleteTarget;
    private bool _schedulesLoaded;

    protected override void OnInitialized()
    {
        var route = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
        _activeSection = string.Equals(route, "fleet/schedules", StringComparison.OrdinalIgnoreCase)
            ? "schedules"
            : "approvals";
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        await EnsureActiveSectionLoadedAsync();
        if (_activeSection == "approvals")
        {
            _ = LoadStatusCountsAsync();
        }
    }

    private async Task OnSectionChanged(ChangeEventArgs e)
    {
        _activeSection = e.Value?.ToString() == "schedules" ? "schedules" : "approvals";
        await EnsureActiveSectionLoadedAsync();
    }

    private async Task EnsureActiveSectionLoadedAsync()
    {
        if (_activeSection == "approvals")
        {
            if (!_approvalsLoaded)
            {
                await ReloadApprovalsAsync();
            }
        }
        else if (!_schedulesLoaded)
        {
            await ReloadSchedulesAsync();
        }
    }

    private Task ReloadApprovalsAsync() => Reload();

    private async Task Reload()
    {
        _loading = true;
        _error = null;
        _selected.Clear();
        _approveResult = null;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
            _updates = await BrokerApi.GetCatalogUpdatesAsync(_currentStatus, cts.Token);
            _statusCounts[_currentStatus] = _updates.Count;
            _approvalsLoaded = true;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (OperationCanceledException)
        {
            _error = "Request timed out (15s). The Action1 API did not respond — try again or check broker logs at https://seq.cowgomu.net";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SwitchStatus(string status)
    {
        _currentStatus = status;
        await Reload();
    }

    private async Task TestConnection()
    {
        _testing = true;
        _testResult = null;
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(25));
            _testResult = await BrokerApi.TestCatalogConnectionAsync(cts.Token);
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _testResult = new CatalogTestResultDto(false, false, 0, 0, ex.Message);
        }
        finally
        {
            _testing = false;
        }
    }

    private async Task LoadStatusCountsAsync()
    {
        var tasks = new[] { "New", "Approved", "Declined" }
            .Where(s => s != _currentStatus)
            .Select(async s =>
            {
                try
                {
                    using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(15));
                    var list = await BrokerApi.GetCatalogUpdatesAsync(s, cts.Token);
                    return (Status: s, Count: list.Count);
                }
                catch
                {
                    return (Status: s, Count: 0);
                }
            });

        foreach (var result in await Task.WhenAll(tasks))
        {
            _statusCounts[result.Status] = result.Count;
        }

        StateHasChanged();
    }

    private IReadOnlyList<CatalogUpdateDto> VisibleUpdates =>
        _updates is null ? []
        : _severityFilter == "All"
            ? _updates
            : _updates.Where(u => string.Equals(u.Severity, _severityFilter, StringComparison.OrdinalIgnoreCase)).ToList();

    private int TotalSelectedCount => _selected.Count;

    private bool AllVisibleSelected =>
        VisibleUpdates.Count > 0 && VisibleUpdates.All(u => _selected.Contains(u.Id));

    private void ToggleOne(string id, bool value)
    {
        if (value) _selected.Add(id);
        else _selected.Remove(id);
    }

    private void ToggleAll(bool value)
    {
        if (value) foreach (var u in VisibleUpdates) _selected.Add(u.Id);
        else foreach (var u in VisibleUpdates) _selected.Remove(u.Id);
    }

    private Task ApproveSelected() => BulkSetStatus("Approved");
    private Task DeclineSelected() => BulkSetStatus("Declined");

    private async Task BulkSetStatus(string status)
    {
        if (_selected.Count == 0) return;
        await SubmitApproval(_selected.ToList(), status);
    }

    private async Task ApproveAll()
    {
        var ids = VisibleUpdates.Select(u => u.Id).ToList();
        if (ids.Count == 0) return;
        await SubmitApproval(ids, "Approved");
    }

    private async Task SubmitApproval(List<string> ids, string status)
    {
        _submitting = true;
        _approveResult = null;
        _jobProgress = null;
        try
        {
            var started = await BrokerApi.StartApprovalJobAsync(new CatalogApproveRequestDto(ids, status));
            var jobId = started.JobId;

            while (true)
            {
                await Task.Delay(2000);
                try
                {
                    _jobProgress = await BrokerApi.GetApprovalJobStatusAsync(jobId);
                    StateHasChanged();
                    if (_jobProgress.IsComplete) break;
                }
                catch
                {
                }
            }

            _approveResult = _jobProgress;
            _jobProgress = null;
            await Reload();
            _ = LoadStatusCountsAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
            StateHasChanged();
        }
    }

    private async Task ReloadSchedulesAsync()
    {
        _schedulesLoading = true;
        _scheduleError = null;
        _scheduleSyncResult = null;
        try
        {
            _scheduleList = await BrokerApi.GetSchedulesAsync();
            _schedulesLoaded = true;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _scheduleError = ex.Message;
        }
        finally
        {
            _schedulesLoading = false;
            StateHasChanged();
        }
    }

    private async Task SyncNow()
    {
        _syncing = true;
        _scheduleSyncResult = null;
        _scheduleError = null;
        try
        {
            _scheduleSyncResult = await BrokerApi.SyncSchedulesAsync();
            await ReloadSchedulesAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _scheduleError = ex.Message;
        }
        finally
        {
            _syncing = false;
        }
    }

    private async Task EnableSchedule(ScheduleDto s)
    {
        _scheduleError = null;
        try
        {
            await BrokerApi.PatchScheduleAsync(s.Id, new SchedulePatchRequestDto("ENABLED ONCE AT:02-00-00", null));
            await ReloadSchedulesAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _scheduleError = ex.Message;
        }
    }

    private async Task DisableSchedule(ScheduleDto s)
    {
        _scheduleError = null;
        try
        {
            await BrokerApi.PatchScheduleAsync(s.Id, new SchedulePatchRequestDto("DISABLED", null));
            await ReloadSchedulesAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _scheduleError = ex.Message;
        }
    }

    private void ConfirmDelete(ScheduleDto s) => _deleteTarget = s;
    private void CancelDelete() => _deleteTarget = null;

    private async Task ExecuteDelete()
    {
        if (_deleteTarget is null) return;
        var id = _deleteTarget.Id;
        _deleteTarget = null;
        _scheduleError = null;
        try
        {
            await BrokerApi.DeleteScheduleAsync(id);
            await ReloadSchedulesAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception ex)
        {
            _scheduleError = ex.Message;
        }
    }

    private static bool IsCritical(CatalogUpdateDto u) =>
        string.Equals(u.Severity, "Critical", StringComparison.OrdinalIgnoreCase);

