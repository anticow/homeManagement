{
  "BrokerApi": {
    "BaseUrl": "http://localhost:8082"
  },
  "AuthApi": {
    "BaseUrl": "http://localhost:8083"
  },
  "Grafana": {
    "BaseUrl": "",
    "NodeExporterDashboardUid": "node-exporter-full",
    "WindowsExporterDashboardUid": "windows-exporter",
    "CpuPanelId": 3,
