    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.SignalR": "Information",
        "System.Net.Http": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
